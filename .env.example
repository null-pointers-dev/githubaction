# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://flowdeck:flowdeck@localhost:5432/flowdeck
REDIS_URL=redis://localhost:6379

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000


# Allow new people to sign up. The first account ever created becomes admin.
# Set to false after your team has joined; admins can still change roles.
ALLOW_SIGNUP=true

# Encrypts stored GitHub tokens and App keys (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-base64

# --- GitHub ---------------------------------------------------------------
# Secret configured on the GitHub webhook (App, org or repo webhook).
GITHUB_WEBHOOK_SECRET=change-me
# Optional: previous secret, accepted during rotation.
GITHUB_WEBHOOK_SECRET_PREVIOUS=

# REST API base URL. Change for GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# Optional: "Sign in with GitHub" (an OAuth App or a GitHub App's OAuth credentials).
# Needed for the "Mirror GitHub reviewers" approval mode, because it tells
# FlowDeck each person's GitHub username. Callback URL:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
